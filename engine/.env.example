# Non-secret environment template. Secret values belong in credential files with
# mode 0600 (systemd credentials, Vault agent, Docker secrets or equivalent).
BINANCE_TESTNET=true
BINANCE_TRADE_API_KEY_FILE=/run/credentials/binance_trade_api_key
BINANCE_TRADE_API_SECRET_FILE=/run/credentials/binance_trade_api_secret
BINANCE_USER_DATA_API_KEY_FILE=/run/credentials/binance_user_data_api_key
BINANCE_USER_DATA_API_SECRET_FILE=/run/credentials/binance_user_data_api_secret
BINANCE_MONITOR_API_KEY_FILE=/run/credentials/binance_monitor_api_key
BINANCE_MONITOR_API_SECRET_FILE=/run/credentials/binance_monitor_api_secret

SYMBOLS=BTCUSDT,ETHUSDT
EXECUTION_TIMEFRAME=5m
STATE_DB=/var/lib/smc-execution/execution_state.db
OPERATOR_DB=/var/lib/smc-execution/operator.db
RESEARCH_DB=/var/lib/smc-execution/research.db

OPERATOR_TOKEN_FILE=/run/credentials/operator_token
OPERATOR_ACTOR=operator
OPERATOR_HOST=127.0.0.1
OPERATOR_PORT=8080
OPERATOR_BEHIND_HTTPS_PROXY=false
OPERATOR_TRUSTED_PROXY_IPS=127.0.0.1
TELEMETRY_INTERVAL_SECONDS=5
ALLOW_FLATTEN_COMMAND=true

# Direct TLS is supported. For deployment behind nginx, leave these empty and set
# OPERATOR_BEHIND_HTTPS_PROXY=true.
OPERATOR_TLS_CERT=
OPERATOR_TLS_KEY=

# Redis is reachable only over the private Docker network in the supplied compose.
REDIS_URL=redis://redis:6379/0

# Alpha research and governance
RESEARCH_BOOTSTRAP_SAMPLES=2000
RESEARCH_MINIMUM_BARS=10000
RESEARCH_MINIMUM_SPAN_DAYS=90
RESEARCH_MINIMUM_SHADOW_TRADES=20
ALLOW_LIVE_RESEARCH_PROMOTION=false

AUTO_SIGNAL_GENERATOR=false
APPROVED_RUN_IDS=
SIGNAL_ENVIRONMENT=shadow
SIGNAL_POLL_SECONDS=5
SIGNAL_HISTORY_BARS=500

# Acceptance-staging fields for a future CANARY_ONLY build. The current build
# rejects BINANCE_TESTNET=false before these values are used.
# The JSON authorization is detached from this environment file and must have two
# valid Ed25519 operator signatures.
LIVE_CONFIG_FILE=/etc/smc-execution/live-authorization.json
LIVE_APPROVER_PUBLIC_KEYS_DIR=/etc/smc-execution/approvers
LIVE_DEPLOYMENT_ID=<replace-with-immutable-deployment-id>
BINANCE_LIVE_SUBACCOUNT_ID=<replace-with-dedicated-subaccount-id>
