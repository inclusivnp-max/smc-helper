[Unit]
Description=SMC Execution Engine Operator Dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=smc-execution
Group=smc-execution
WorkingDirectory=/opt/smc-execution
EnvironmentFile=/etc/smc-execution/environment
LoadCredential=binance_trade_api_key:/etc/smc-execution/credentials/binance_trade_api_key
LoadCredential=binance_trade_api_secret:/etc/smc-execution/credentials/binance_trade_api_secret
LoadCredential=binance_user_data_api_key:/etc/smc-execution/credentials/binance_user_data_api_key
LoadCredential=binance_user_data_api_secret:/etc/smc-execution/credentials/binance_user_data_api_secret
LoadCredential=binance_monitor_api_key:/etc/smc-execution/credentials/binance_monitor_api_key
LoadCredential=binance_monitor_api_secret:/etc/smc-execution/credentials/binance_monitor_api_secret
LoadCredential=operator_token:/etc/smc-execution/credentials/operator_token
Environment=BINANCE_TRADE_API_KEY_FILE=%d/binance_trade_api_key
Environment=BINANCE_TRADE_API_SECRET_FILE=%d/binance_trade_api_secret
Environment=BINANCE_USER_DATA_API_KEY_FILE=%d/binance_user_data_api_key
Environment=BINANCE_USER_DATA_API_SECRET_FILE=%d/binance_user_data_api_secret
Environment=BINANCE_MONITOR_API_KEY_FILE=%d/binance_monitor_api_key
Environment=BINANCE_MONITOR_API_SECRET_FILE=%d/binance_monitor_api_secret
Environment=OPERATOR_TOKEN_FILE=%d/operator_token
ExecStart=/opt/smc-execution/.venv/bin/python examples/run_operator_dashboard.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/smc-execution
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
MemoryMax=2G
CPUQuota=200%
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
